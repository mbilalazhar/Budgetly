{
  "name": "budgetly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build",
    "start": "node init && next start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.test.json && node --test --experimental-test-isolation=none .test-build/tests/*.test.js",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "check": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
