# Copy to .env.local. Keep real credentials out of source control.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=budgetly
AUTH_USERNAME=your-username
AUTH_PASSWORD=replace-with-a-long-unique-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# All accounts use one currency, with two decimal places.
BUDGET_CURRENCY=PKR
# Optional: public origin when hosted behind a reverse proxy (no path).
# APP_ORIGIN=https://budget.example.com
